{
  "log": {
    "disabled": false,
    "level": "warn",
    "timestamp": true
  },
  "certificate_providers": [
    {
      "type": "acme",
      "tag": "任意命名：比如a1",
      "domain": [
        "你的域名"
      ],
      "data_directory": "/var/lib/sing-box/acme",
      "default_server_name": "你的域名",
      "email": "你的CF登录邮箱",
      "provider": "letsencrypt",
      "key_type": "p256",
      "dns01_challenge": {
        "provider": "cloudflare",
        "api_token": "你的CF api token"
      }
    }
  ],
  "services": [
    {
      "type": "derp",
      "listen": "::",
      "listen_port": 443,
      "config_path": "/var/lib/sing-box/derp.key",
      "stun": {
        "enabled": true,
        "listen_port": 3478
      },
      "tls": {
        "enabled": true,
        "server_name": "你的域名",
        "certificate_provider": "上面acmetag的任意命名a1"
      }
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": [
          "bittorrent",
          "quic"
        ],
        "action": "reject",
        "method": "default"
      },
      {
        "inbound": "hy2-in",  
        "outbound": "direct"
      }
    ]
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "::",
      "listen_port": 2053,
      "users": [
        {
          "name": "任意名字",
          "password": "输入你的密码"
        }
      ],
      "obfs": {
          "type": "salamander",
          "password": "输入你的密码"
      },
      "masquerade": {
          "type": "proxy",
          "url": "https://www.microsoft.com",
          "rewrite_host": true
      },
      "tls": {
        "enabled": true,
        "server_name": "你的域名",
        "alpn": [
          "h3"
        ],
        "certificate_provider": "上面acme tag的任意命名a1"
      }
    }
  ]
}