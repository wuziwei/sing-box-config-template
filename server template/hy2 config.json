{
  "log": {
    "disabled": "warn",
    "level": "info",
    "timestamp": true
  },
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": [
          "bittorrent",
          "quic"
        ],
        "action": "reject",
        "method": "default"
      },
      {
        "inbound": "hy2-in",  
        "outbound": "direct"
      }
    ]
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "::",
      "listen_port": 2053,
      "users": [
        {
          "name": "input your name",
          "password": "input your pw"
        }
      ],
      "obfs": {
          "type": "salamander",
          "password": "input any pw "
      },
      "masquerade": {
          "type": "proxy",
          "url": "https://www.microsoft.com",
          "rewrite_host": true
      },
      "tls": {
        "enabled": true,
        "server_name": "input your domain",
        "alpn": [
          "h3"
        ],
        "certificate_path": "input your certificate path",
        "key_path": "input your key path"
      }
    }
  ]
}
